{
  "manifest_version": 3,
  "name": "bs-vimium-c",
  "version": "0.1.0",
  "description": "Keyboard-driven browser navigation",
  "permissions": ["tabs", "sessions", "downloads", "windows", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
